  _billboard: {fileID: 896315147}
  _title: "D\xFCz Tahta Y\xFCr\xFCme Testi Hakk\u0131nda"
  _body: "Bu sim\xFClasyon, alkol etkisinin denge ve koordinasyon \xFCzerindeki etkilerini
    deneyimlemenizi sa\u011Flar. Yerde belirecek dar tahta \xFCzerinde ileri do\u011Fru
    y\xFCr\xFCmeye \xE7al\u0131\u015F\u0131n. Sim\xFClasyon s\xFCresince g\xF6rsel
    bozulmalar alkol etkisini temsil edecektir. D\xFC\u015Fme riskiniz yoktur \u2014
    ger\xE7ek ortam\u0131n\u0131z\u0131 g\xF6rmeye devam edersiniz. Haz\u0131r oldu\u011Funuzda
    'Ba\u015Flat' butonuna bas\u0131n."
  _spawnDistance: 1.15
  _verticalOffset: -0.04
  _panelSizeMeters: {x: 0.42, y: 0.34}
  _worldScale: 0.001
  _appearDuration: 0.35
  _scaleFrom: 0.8
  _scaleTo: 1
